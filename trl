#!/usr/bin/env python3

from abc import ABC, abstractmethod
import argparse
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tempfile
import requests
import warnings
from typing import TYPE_CHECKING, Callable, Optional, Protocol, TypeVar, TypedDict, cast

if TYPE_CHECKING:
    from typing_extensions import override

    class CliArgs(Protocol):
        provider: str
        target: str
        content: Optional[str]
        input_file: Optional[str]
        edit: bool
        source: Optional[str]
        file: Optional[Path]
        key: Optional[str]
        more_output: bool
        port: Optional[int]
        base_url: Optional[str]
        model: Optional[str]
else:
    _F = TypeVar("_F", bound=Callable[..., object])

    def override(method: _F, /) -> _F:
        return method

    CliArgs = argparse.Namespace


class DeepLTranslationResult(TypedDict):
    text: str
    detected_source_language: str


class DeepLTranslationResponse(TypedDict):
    translations: list[DeepLTranslationResult]


class LibreTranslateDetectedLanguage(TypedDict):
    language: str


class LibreTranslateResponse(TypedDict):
    translatedText: str
    detectedLanguage: LibreTranslateDetectedLanguage


class OllamaGenerateResponse(TypedDict):
    response: str


UNIX_EDITOR_CANDIDATES: tuple[tuple[str, tuple[str, ...]], ...] = (
    ("sensible-editor", ()),
    ("editor", ()),
    ("nano", ()),
    ("nvim", ()),
    ("vim", ()),
    ("vi", ()),
    ("hx", ()),
    ("kak", ()),
    ("micro", ()),
    ("code", ("--wait",)),
    ("code-insiders", ("--wait",)),
    ("codium", ("--wait",)),
    ("codium-insiders", ("--wait",)),
    ("cursor", ("--wait",)),
    ("zed", ("--wait",)),
)

GUI_EDITOR_WAIT_FLAGS: dict[str, tuple[str, ...]] = {
    editor: wait_args
    for editor, wait_args in UNIX_EDITOR_CANDIDATES
    if wait_args
}


class BaseTranslationProvider(ABC):
    name: str = ""
    api_key: str
    requires_api_key: bool = True

    def __init__(self, api_key: str):
        self.api_key = api_key

    @abstractmethod
    def translate(
        self,
        target_lang: str,
        source_text: str,
        source_lang: str = "",
        more_output: bool = False,
        port: Optional[int] = None,
        base_url: Optional[str] = None,
        model: str = "",
    ) -> str:
        ...

    def translate_and_print(
        self,
        target_lang: str,
        source_text: str,
        source_lang: str = "",
        more_output: bool = False,
        port: Optional[int] = None,
        base_url: Optional[str] = None,
        model: str = "",
    ) -> None:
        print(
            self.translate(
                target_lang,
                source_text,
                source_lang,
                more_output,
                port,
                base_url,
                model,
            )
        )

    @staticmethod
    def pretty_format_more_output(
        target_lang: str,
        text: str,
        translated_text: str,
        source_lang: str = "",
        detected_lang: str = "",
    ) -> str:
        out = "\n    Request:\n"
        out += f"    Target language: {target_lang.upper()}\n"
        out += f"    >>> '{text}'\n\n"
        out += "    Answer:\n"
        if source_lang:
            out += f"    Supplied source language: {source_lang.upper()}\n"
        elif detected_lang:
            out += f"    Detected source language: {detected_lang.upper()}\n"
        else:
            out += "    Detected source language: unavailable\n"
        out += f"    >>> '{translated_text}'\n"
        return out

    @staticmethod
    def resolve_base_url(
        provider_name: str,
        default_port: int,
        port: Optional[int] = None,
        base_url: Optional[str] = None,
    ) -> str:
        if base_url:
            if port is not None:
                warnings.warn(
                    f"Port argument is ignored when base URL is set for provider '{provider_name}'."
                )
            return base_url.rstrip("/")

        return f"http://localhost:{port or default_port}"

    @staticmethod
    def build_url(base_url: str, path: str) -> str:
        normalized_base_url = base_url.rstrip("/")
        normalized_path = path if path.startswith("/") else f"/{path}"
        return f"{normalized_base_url}{normalized_path}"


class DeepLProvider(BaseTranslationProvider):
    name: str = "deepl"

    @override
    def translate(
        self,
        target_lang: str,
        source_text: str,
        source_lang: str = "",
        more_output: bool = False,
        port: Optional[int] = None,
        base_url: Optional[str] = None,
        model: str = "",
    ) -> str:
        if port is not None or base_url is not None:
            warnings.warn(
                "Connection options are ignored with this translation provider."
            )
        if model:
            warnings.warn("Model argument is ignored with this translation provider.")

        url = "https://api-free.deepl.com/v2/translate"
        headers = {"Authorization": f"DeepL-Auth-Key {self.api_key}"}
        data = {"text": source_text, "target_lang": target_lang}
        if source_lang:
            data["source_lang"] = source_lang

        try:
            response = requests.post(url, headers=headers, data=data)
        except requests.RequestException as error:
            raise RuntimeError(
                "Error: failed to reach DeepL.\nAre your network connection and API settings correct?"
            ) from error
        if response.status_code != 200:
            raise RuntimeError(
                "Error: failed to fetch translation from DeepL.\nAre your API key and language code set correctly?",
            )
        response_json = cast(DeepLTranslationResponse, response.json())
        translated_text: str = response_json["translations"][0]["text"]
        detected_lang: str = response_json["translations"][0][
            "detected_source_language"
        ]

        if more_output:
            return BaseTranslationProvider.pretty_format_more_output(
                target_lang, source_text, translated_text, source_lang, detected_lang
            )
        return translated_text


class LibreTranslateSelfhostedProvider(BaseTranslationProvider):
    name: str = "libretranslate"
    requires_api_key: bool = False

    @override
    def translate(
        self,
        target_lang: str,
        source_text: str,
        source_lang: str = "",
        more_output: bool = False,
        port: Optional[int] = None,
        base_url: Optional[str] = None,
        model: str = "",
    ) -> str:
        if model:
            warnings.warn("Model argument is ignored with this translation provider.")

        service_base_url = BaseTranslationProvider.resolve_base_url(
            self.name,
            default_port=5000,
            port=port,
            base_url=base_url,
        )
        url = BaseTranslationProvider.build_url(service_base_url, "/translate")
        payload = {
            "q": source_text,
            "source": source_lang if source_lang else "auto",
            "target": target_lang,
            "format": "text",
            # "alternatives": 3,
        }

        if self.api_key:
            payload["api_key"] = self.api_key

        try:
            response = requests.post(
                url, json=payload, headers={"Content-Type": "application/json"}
            )
        except requests.RequestException as error:
            raise RuntimeError(
                "Error: failed to reach LibreTranslate.\n"
                "Is the server reachable at the selected base URL or port?"
            ) from error
        if response.status_code != 200:
            # (potential) TODO: can detection of available languages be
            # automated/queried somehow with self-hosted LibreTranslate?
            raise RuntimeError(
                "Error: failed to fetch translation from LibreTranslate.\nAre your API key, port, and language code set correctly?\nWhich languages are available/downloaded on your instance?",
            )
        response_json = cast(LibreTranslateResponse, response.json())
        translated_text: str = response_json["translatedText"]
        detected_lang: str = response_json["detectedLanguage"]["language"]

        if more_output:
            return BaseTranslationProvider.pretty_format_more_output(
                target_lang,
                source_text,
                translated_text,
                source_lang if source_lang else "",
                detected_lang,
            )
        return translated_text


class OllamaProvider(BaseTranslationProvider):
    name: str = "ollama"
    requires_api_key: bool = False

    @staticmethod
    def build_system_prompt(target_lang: str, source_lang: str = "") -> str:
        if source_lang:
            source_instruction = (
                f"The source language is {source_lang.upper()}; treat that as authoritative."
            )
        else:
            source_instruction = "Infer the source language from the user's text."

        return (
            "You are a translation engine.\n"
            f"Translate the user's text into {target_lang.upper()}.\n"
            f"{source_instruction}\n"
            "Return only the final translation.\n"
            "Do not add explanations, notes, alternatives, transliterations, "
            "romanizations, quotes, or markdown fences.\n"
            "Preserve the original meaning, tone, formatting, line breaks, code, "
            "placeholders, and markup whenever possible.\n"
            "If a term should remain unchanged, keep it unchanged."
        )

    @override
    def translate(
        self,
        target_lang: str,
        source_text: str,
        source_lang: str = "",
        more_output: bool = False,
        port: Optional[int] = None,
        base_url: Optional[str] = None,
        model: str = "",
    ) -> str:
        if not model:
            raise RuntimeError(
                "Error: no model specified for Ollama.\nUse --model or set TRL_OLLAMA_MODEL."
            )

        service_base_url = BaseTranslationProvider.resolve_base_url(
            self.name,
            default_port=11434,
            port=port,
            base_url=base_url,
        )
        url = BaseTranslationProvider.build_url(service_base_url, "/api/generate")
        payload = {
            "model": model,
            "prompt": source_text,
            "system": self.build_system_prompt(target_lang, source_lang),
            "stream": False,
            "options": {"temperature": 0},
        }

        try:
            response = requests.post(url, json=payload)
        except requests.RequestException as error:
            raise RuntimeError(
                "Error: failed to reach Ollama.\n"
                "Is the server reachable at the selected base URL or port?"
            ) from error
        if response.status_code != 200:
            raise RuntimeError(
                "Error: failed to fetch translation from Ollama.\n"
                "Are the model name and base URL correct, and is the Ollama server running?",
            )
        response_json = cast(OllamaGenerateResponse, response.json())
        translated_text = response_json["response"].strip()

        if more_output:
            return BaseTranslationProvider.pretty_format_more_output(
                target_lang,
                source_text,
                translated_text,
                source_lang,
            )
        return translated_text


# TODO: additional providers can be added here in the future, as well as in the
# providers dictionary below with one or multiple shorthand forms of the class
# name for quick switching in the CLI


def get_provider(provider_name: str, api_key: str) -> BaseTranslationProvider:
    """
    Return the provider instance corresponding to the given provider name.

    :param provider_name: The name of the translation provider.
    :param api_key: API key to authenticate with the provider.
    :raises ValueError: If the provider name is not recognized.
    :return: An instance of BaseProvider.
    """
    providers: dict[str, type[BaseTranslationProvider]] = {
        "deepl": DeepLProvider,
        "d": DeepLProvider,
        "libretranslate": LibreTranslateSelfhostedProvider,
        "local_libre": LibreTranslateSelfhostedProvider,
        "libre": LibreTranslateSelfhostedProvider,
        "lt": LibreTranslateSelfhostedProvider,
        "ollama": OllamaProvider,
        "local_ollama": OllamaProvider,
        "o": OllamaProvider,
        # TODO: New provider classes abbreviations can be added here
    }
    provider_class = providers.get(provider_name.lower())
    if not provider_class:
        raise ValueError(f"Error: Unknown provider '{provider_name}'")
    return provider_class(api_key)


def read_content_source(
    direct_content: Optional[str], input_file: Optional[str], use_editor: bool
) -> Optional[str]:
    if direct_content is not None:
        return direct_content

    if input_file:
        if input_file == "-":
            return sys.stdin.read()

        try:
            with open(input_file, "r", encoding="utf-8") as file:
                return file.read()
        except OSError as error:
            print(
                f"Error: failed to read the specified input file: {error}",
                file=sys.stderr,
            )
            sys.exit(1)

    if use_editor:
        return edit_content()

    if not sys.stdin.isatty():
        return sys.stdin.read()

    return None


def get_editor_command() -> list[str]:
    if os.name == "nt":
        raise RuntimeError("Error: --edit is not supported on Windows.")

    for env_var in ("VISUAL", "EDITOR"):
        value = os.getenv(env_var)
        if value:
            return add_editor_wait_args(shlex.split(value))

    for editor, wait_args in UNIX_EDITOR_CANDIDATES:
        editor_path = shutil.which(editor)
        if editor_path:
            return [editor_path, *wait_args]

    raise RuntimeError(
        "Error: no suitable Unix editor found. Set VISUAL or EDITOR to use --edit."
    )


def add_editor_wait_args(command: list[str]) -> list[str]:
    if not command:
        raise RuntimeError("Error: VISUAL or EDITOR is set, but empty after parsing.")

    editor_name = os.path.basename(command[0])
    wait_args = GUI_EDITOR_WAIT_FLAGS.get(editor_name)
    if not wait_args or "--wait" in command:
        return command

    return [*command, *wait_args]


def edit_content() -> str:
    fd, temp_path = tempfile.mkstemp(prefix="trl-", suffix=".txt")
    os.close(fd)

    try:
        editor_command = get_editor_command()
        try:
            result = subprocess.run(editor_command + [temp_path])
        except OSError as error:
            raise RuntimeError(
                f"Error: failed to launch the editor: {error}"
            ) from error
        if result.returncode != 0:
            raise RuntimeError("Error: editor exited unsuccessfully.")

        with open(temp_path, "r", encoding="utf-8") as file:
            return file.read()
    finally:
        try:
            os.unlink(temp_path)
        except FileNotFoundError:
            pass


def main():
    target_default = os.getenv("TRL_DEFAULT_TARGET_LANG")
    ollama_model_default = os.getenv("TRL_OLLAMA_MODEL")
    parser = argparse.ArgumentParser(
        prog="trl",
        description="Translate phrases quickly using various translation providers",
        epilog="Registration for an API key is free with DeepL (https://deepl.com/api) and thus recommended for getting started. Self-hosted providers such as LibreTranslate or Ollama may not require one.",
    )

    _ = parser.add_argument(
        "-p",
        "--provider",
        type=str,
        default="deepl",
        help="Translation API provider to use. Default is 'DeepL'.",
    )
    _ = parser.add_argument(
        "-t",
        "--target",
        type=str,
        default=target_default,
        required=(target_default is None),
        help="Two-letter target language code, ex. FR, ES, DE, JA, ...",
    )
    content_group = parser.add_mutually_exclusive_group()
    _ = content_group.add_argument(
        "-c",
        "--content",
        type=str,
        help="Content to be translated. Omit this when using --input-file, --edit, or stdin.",
    )
    _ = content_group.add_argument(
        "-i",
        "--input-file",
        help="Path to a file containing the content to be translated. Use '-' to read stdin explicitly.",
    )
    _ = content_group.add_argument(
        "-e",
        "--edit",
        action="store_true",
        help="Open a Unix editor to compose the content to be translated (not supported on Windows).",
    )
    _ = parser.add_argument(
        "-s", "--source", type=str, help="(optional) Specify the source language."
    )
    _ = parser.add_argument(
        "-f",
        "--file",
        type=Path,
        help="Path to file containing the API key. Takes precedence over TRL_API_KEY environment variable.",
    )
    _ = parser.add_argument(
        "-k",
        "--key",
        type=str,
        help="Pass your API key directly. Takes precedence over file and environment variable.",
    )
    _ = parser.add_argument(
        "-m",
        "--more_output",
        "--more-output",
        action="store_true",
        help='Enable "more output" formatting with input and language detection info.',
    )
    _ = parser.add_argument(
        "--port",
        type=int,
        help="Port when your translation service is running on localhost. Defaults depend on the provider, e.g. 5000 for LibreTranslate and 11434 for Ollama.",
    )
    _ = parser.add_argument(
        "--base-url",
        type=str,
        help="Base URL for self-hosted or remote providers, e.g. http://localhost:11434 or https://example.com:11434. Ollama defaults to http://localhost:11434 when this is omitted.",
    )
    _ = parser.add_argument(
        "--model",
        type=str,
        default=None,
        help="Model name for providers that require one, e.g. an Ollama model. Can also be set via TRL_OLLAMA_MODEL.",
    )
    args = cast(CliArgs, cast(object, parser.parse_args()))

    api_key = os.getenv("TRL_API_KEY", "")
    if args.file:
        try:
            with open(args.file, "r", encoding="utf-8") as file:
                for line in file:
                    if "TRL_API_KEY" in line:
                        api_key = line.split()[1]
                        break
        except FileNotFoundError:
            print("Error: specified API key file does not exist.", file=sys.stderr)
            sys.exit(1)
    if args.key is not None:
        api_key = args.key
    try:
        provider = get_provider(args.provider, api_key)
    except ValueError as error:
        print(error, file=sys.stderr)
        sys.exit(1)
    if provider.requires_api_key and not api_key:
        print(
            'Please provide a valid API key via file, environment variable ($TRL_API_KEY), or the --key option.\nIf your provider does not require an API key, you can pass --key " " (or set the environment variable) to circumvent this message.',
            file=sys.stderr,
        )
        sys.exit(1)

    model = args.model
    if isinstance(provider, OllamaProvider) and model is None:
        model = ollama_model_default

    try:
        content = read_content_source(args.content, args.input_file, args.edit)
    except RuntimeError as error:
        print(error, file=sys.stderr)
        sys.exit(1)
    if content is None or content == "":
        print(
            "Content is required. Use -c/--content, --input-file, --edit, or provide content via stdin. Use -h for help.",
            file=sys.stderr,
        )
        sys.exit(1)

    try:
        provider.translate_and_print(
            args.target,
            content,
            args.source or "",
            args.more_output,
            args.port,
            args.base_url,
            model or "",
        )
    except RuntimeError as error:
        print(error, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
